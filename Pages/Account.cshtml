@page
@model AccountModel
@{ ViewData["Title"] = "Личный кабинет"; }
<section class="sec" style="padding-bottom:10px"><h1>Привет, @Model.Me.Name!</h1></section>

<div class="account">
  <div class="side-menu">
    <a href="#" class="on">Профиль</a>
    <a href="#">Текущие заказы</a>
    <a href="#">Мои заказы</a>
    <a href="#">Избранное</a>
    <a href="#">Накопленные бонусы</a>
    <a href="#">Личные данные</a>
    <a href="#">Подписки</a>
    <a href="/Reviews">Мои отзывы</a>
    <a href="#">Мои адреса</a>
    <form method="post" asp-page-handler="Logout"><button class="btn ghost block" style="margin-top:10px">Выйти</button></form>
  </div>
  <div>
    <div class="stats">
      <div class="stat"><b>240</b><span>Бонусы</span></div>
      <div class="stat"><b>Серебряный</b><span>Ваш статус</span></div>
      <div class="stat"><b>5%</b><span>Скидка</span></div>
    </div>
    <div class="account-banner paws"><h2>Скидка 20%</h2><p>на 2-ю весеннюю одежду и амуницию</p><a class="btn white" href="/Promotions">Все акции</a></div>

    @if (!Model.Orders.Any()){ <p>Заказов пока нет.</p><a class="btn" href="/Catalog">В каталог</a> }
    @foreach (var o in Model.Orders){ <div class="line"><div><b>Заказ №@o.Id</b> от @o.Created.ToLocalTime().ToString("dd.MM.yyyy")<br><small>@o.Items</small></div><div><b>@o.Total.ToString("0") ₽</b><br><small>@o.Status</small></div></div> }

    <section class="sec" style="padding:34px 0">
      <h2>Вы смотрели</h2>
      <div class="carousel">
        <button class="arrow prev" data-dir="-1" aria-label="Назад">‹</button>
        <div class="row">@foreach (var p in Store.Products.Take(4)){ <partial name="_Card" model="p" /> }</div>
        <button class="arrow next" data-dir="1" aria-label="Вперёд">›</button>
      </div>
    </section>
    <section class="sec" style="padding:0">
      <h2>Подборки для вас</h2>
      <div class="carousel">
        <button class="arrow prev" data-dir="-1" aria-label="Назад">‹</button>
        <div class="row">@foreach (var p in Store.Products.Skip(5).Take(5)){ <partial name="_Card" model="p" /> }</div>
        <button class="arrow next" data-dir="1" aria-label="Вперёд">›</button>
      </div>
    </section>
  </div>
</div>
