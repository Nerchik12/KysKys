@page
@model CartModel
@{ ViewData["Title"] = "Корзина"; }

@if (!Model.Items.Any())
{
  <section class="sec" style="text-align:center;padding:90px 4vw">
    <h1>Мяу… в корзине пусто :(</h1>
    <p style="font-size:18px;color:var(--muted)">Давайте это исправим</p>
    <a class="btn" href="/Catalog">За покупками</a>
  </section>
}
else
{
  <section class="sec">
    <h1>Товары в корзине — @Model.Items.Count</h1>
    <div class="checkout">
      <div>
        @foreach (var p in Model.Items)
        {
          <div class="line cart-line">
            <div style="display:flex;gap:16px;align-items:center">
              <span style="font-size:52px;background:var(--g2);border-radius:16px;padding:8px 12px">@p.Icon</span>
              <div><b>@p.Name</b><br><span class="pr" style="color:var(--o);font-weight:800">@p.Price.ToString("0") ₽</span></div>
            </div>
            <div class="qty">
              <form method="post" asp-page-handler="Remove" asp-route-id="@p.Id"><button type="submit" style="border:0;background:none;font-size:18px;cursor:pointer">−</button></form>
              <b>1</b>
              <form method="post" asp-page-handler="Add" asp-route-id="@p.Id"><button type="submit" style="border:0;background:none;font-size:18px;cursor:pointer">+</button></form>
            </div>
          </div>
        }
      </div>
      <div class="panel summary">
        <h2>Ваш заказ</h2>
        <div class="total"><span>Всего</span><b>@Model.Items.Sum(i => i.Price).ToString("0") ₽</b></div>
        <div class="total"><span>Скидка</span><b>0 ₽</b></div>
        <div class="total"><span>Итого</span><b style="color:var(--o);font-size:22px">@Model.Items.Sum(i => i.Price).ToString("0") ₽</b></div>
        <a class="btn block" href="/Checkout" style="margin-top:18px">Перейти к оформлению</a>
      </div>
    </div>
  </section>
}

<section class="sec">
  <h2>Подборка для вас</h2>
  <div class="carousel">
    <button class="arrow prev" data-dir="-1" aria-label="Назад">‹</button>
    <div class="row">@foreach (var p in Store.Products.Skip(10).Take(5)){ <partial name="_Card" model="p" /> }</div>
    <button class="arrow next" data-dir="1" aria-label="Вперёд">›</button>
  </div>
</section>
