@using KysKys.Data
@{ var cnt = CartStore.Get(Context.Session).Count; var p = ViewContext.RouteData.Values["page"]?.ToString() ?? ""; }
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>@ViewData["Title"] — Кыс-Кыс</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<header class="hdr">
  <a class="logo" href="/">Кыс-Кыс</a>
  <input type="checkbox" id="burger" hidden><label for="burger" class="burger" aria-label="Меню">☰</label>
  <nav>
    <a href="/" class="@(p=="/Index"?"on":"")">Главная</a>
    <a href="/Catalog" class="@(p=="/Catalog"?"on":"")">Каталог</a>
    <a href="/Promotions" class="@(p=="/Promotions"?"on":"")">Акции</a>
    <a href="/Brands" class="@(p=="/Brands"?"on":"")">Бренды</a>
    <a href="/Catalog?isNew=true">Новинки</a>
    <a href="/Reviews" class="@(p=="/Reviews"?"on":"")">Отзывы</a>
    <a href="/Contacts" class="@(p=="/Contacts"?"on":"")">Контакты</a>
  </nav>
  <div class="icons">
    <a href="/Cart" class="cartbtn" aria-label="Корзина">🛒@if (cnt > 0){<b>@cnt</b>}</a>
    <a href="@(User.Identity?.IsAuthenticated == true ? "/Account" : "/Login")" aria-label="Кабинет">👤</a>
  </div>
</header>

<a href="#" class="to-top" aria-label="Наверх">↑</a>

<main>@RenderBody()</main>

@if (ViewData["HideContacts"] == null)
{
<section class="contacts">
  <h2>Контактная информация</h2>
  <div class="cgrid">
    <div>
      <ul class="contact-list">
        <li><span class="ico">🕒</span><span>пн–пт 10:00–20:00<br>сб–вс 10:00–18:00</span></li>
        <li><span class="ico">📞</span><span>+7 (000) 000-00-00</span></li>
        <li><span class="ico">✉️</span><span>info@kyskys.ru</span></li>
        <li><span class="ico">📍</span><span>г. Москва, ул. Владимирская, д. 11</span></li>
      </ul>
      <div class="socials"><a href="#" aria-label="Telegram">✈</a><a href="#" aria-label="ВКонтакте">ВК</a></div>
    </div>
    <div class="map">
      <iframe title="Карта" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=37.58%2C55.73%2C37.66%2C55.78&amp;layer=mapnik"></iframe>
      <span class="map-pin">📍</span>
      <span class="map-label">г. Москва, ул. Владимирская, д. 11</span>
    </div>
  </div>
</section>
}

<footer class="ftr">
  <div><b class="logo">Кыс-Кыс</b><p>ООО «Кыс-Кыс»<br>г. Москва, ул. Владимирская, д. 11<br>+7 (000) 000-00-00</p>
    <div class="socials"><a href="#" aria-label="Telegram">✈</a><a href="#" aria-label="ВКонтакте">ВК</a></div>
  </div>
  <div><h4>Информация</h4><a href="#">Помощь</a><a href="#">Условия доставки</a><a href="#">Способы оплаты</a><a href="#">Производителям</a><a href="/Account">Личный кабинет</a></div>
  <div><h4>Компания</h4><a href="/About">О нас</a><a href="#">Сотрудничество</a><a href="#">Вакансии</a><a href="#">Политика конфиденциальности</a><a href="#">Пользовательское соглашение</a></div>
  <div><h4>Контакты</h4><a href="tel:+70000000000">+7 (000) 000-00-00</a><a href="mailto:info@kyskys.ru">info@kyskys.ru</a></div>
  <small>© 2026 Кыс-Кыс</small>
</footer>
<script>
  document.querySelectorAll('.arrow[data-dir]').forEach(function (b) {
    b.addEventListener('click', function () {
      var row = b.parentElement.querySelector('.row');
      if (row) row.scrollBy({ left: Number(b.dataset.dir) * 460, behavior: 'smooth' });
    });
  });
  var top = document.querySelector('.to-top');
  if (top) top.addEventListener('click', function (e) { e.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
</script>
</body>
</html>
