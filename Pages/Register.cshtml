@page
@model RegisterModel
@{ ViewData["Title"] = "Регистрация"; }
<section class="sec teal"><form class="form" method="post"><h1>Регистрация</h1>
  <input name="Name" placeholder="Ваше имя" required maxlength="60">
  <input name="Email" type="email" placeholder="Email" required>
  <input name="Phone" type="tel" placeholder="Телефон">
  <input name="Password" type="password" placeholder="Пароль (от 6 символов)" minlength="6" required>
  @if (Model.Error != null){ <p class="err">@Model.Error</p> }
  <button class="btn">Зарегистрироваться</button><a href="/Login">Уже есть аккаунт? Войти</a></form></section>
