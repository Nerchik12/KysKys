@page
@model ReviewsModel
@{
  ViewData["Title"] = "Отзывы";
  var photos = new[] { ("🐕", "dog"), ("🐈‍⬛", "cat"), ("🦜", "bird") };
  var reviews = Model.Items.ToList();
}
<section class="sec">
  <h1>Отзывы</h1>
  <div class="reviews-grid">
    @for (int i = 0; i < 9; i++)
    {
      if (i % 3 == 0)
      {
        var ph = photos[(i / 3) % photos.Length];
        <div class="photo-card @ph.Item2">@ph.Item1</div>
      }
      else
      {
        var r = reviews[(i - 1 + (i / 3)) % Math.Max(1, reviews.Count)];
        <div class="rev">
          <div class="who"><span class="avatar">🐾</span><b>@r.Name</b></div>
          <div class="stars">@("★★★★★".Substring(0, Math.Max(1, Math.Min(5, r.Stars))))</div>
          <p>@r.Text</p>
          <a class="read-more" href="#modal">Читать полностью</a>
        </div>
      }
    }
  </div>
  <div class="pager"><a href="#" class="on"></a><a href="#"></a><a href="#"></a></div>
  <button class="load-more">Показать еще</button>
</section>

<section class="review-block paws" style="margin-top:20px">
  <h2>Оставьте свой отзыв</h2>
  <p>Расскажите, как наш магазин помог вашему питомцу. Мы всегда рады вашим историям!</p>
  <a class="btn" href="#modal" style="background:var(--o)">Оставить отзыв</a>
</section>

<div id="modal" class="modal">
  <form method="post" class="form">
    <a href="#" class="x">✕</a>
    <h2>Оставьте свой отзыв</h2>
    <p style="font-size:12px;color:var(--muted);margin:0">Поделитесь впечатлениями о товаре или магазине.</p>
    <label>Имя</label><input name="name" placeholder="Имя" required>
    <label>E-mail</label><input name="email" type="email" placeholder="E-mail">
    <label>Питомец / товар</label><input name="pet" placeholder="Например, корм Royal Canin">
    <div class="stars-input">★★★★★</div>
    <select name="stars" style="text-align:center"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select>
    <label>Текст отзыва</label><textarea name="text" placeholder="Ваш отзыв" required></textarea>
    <label class="check"><input type="checkbox" required> Согласен на обработку персональных данных</label>
    <button class="btn teal">Отправить отзыв</button>
  </form>
</div>
